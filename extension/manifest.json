{
  "manifest_version": 3,
  "name": "DevTol - Developer Tools & Productivity Suite",
  "short_name": "DevTol",
  "version": "1.0.0",
  "description": "126+ free offline-ready developer utilities: JSON prettifier, Base64, Token generator, AI Token counter, Unix timestamp & quick tool search.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_title": "DevTol Developer Tools",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [],
  "homepage_url": "https://devtol.online"
}
